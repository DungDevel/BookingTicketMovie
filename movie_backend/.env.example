# Copy file nay thanh ".env" (cung cap Docker-compose.yml) roi doi mat khau truoc khi chay.
# Mat khau SA phai du manh (SQL Server yeu cau): toi thieu 8 ky tu, co chu hoa, chu thuong,
# so va ky tu dac biet.
SA_PASSWORD=Dung.026082004

# --- Cau hinh gui email ve xem phim qua Gmail SMTP ---
# SMTP_USER: dia chi Gmail dung de GUI email (vd: raphim.app@gmail.com)
# SMTP_PASS: KHONG dung mat khau Gmail thuong. Phai tao "Mat khau ung dung" (App Password) 16 ky tu:
#   1. Bat Xac thuc 2 buoc cho tai khoan Google tai https://myaccount.google.com/security
#   2. Vao https://myaccount.google.com/apppasswords, tao mat khau ung dung moi, dan vao SMTP_PASS ben duoi
# MAIL_FROM: dia chi hien thi trong email gui di (mac dinh = SMTP_USER neu bo trong)
#sk-c45ac5c4a7cfcd8e-a1f0a1-c73c4f56
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-app-gmail@gmail.com
SMTP_PASS=your16charapppassword
MAIL_FROM=your-app-gmail@gmail.com
# --- Cau hinh gui email ve xem phim qua EmailJS (mien phi, khong can domain, khong can dien cong ty/postcode) ---
# Dang ky tai https://www.emailjs.com/ (chi can email + ten), ket noi Gmail ca nhan cua ban lam "Email Service",
# tao 1 Email Template voi cac bien: {{to_email}}, {{film_title}}, {{show_date}}, {{show_time}}, {{seats}},
# {{combos}}, {{total_price}}, {{booking_id}}
# EMAILJS_SERVICE_ID: lay o Email Services trong dashboard
# EMAILJS_TEMPLATE_ID: lay o Email Templates trong dashboard
# EMAILJS_PUBLIC_KEY: lay o Account > General
# EMAILJS_PRIVATE_KEY: (khuyen nghi bat de bao mat) lay o Account > Security, bat "Access Token"
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key
